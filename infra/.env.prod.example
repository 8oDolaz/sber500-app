# Production settings for infra/compose.prod.yml. Copy to infra/.env.prod on the server, or paste the
# whole filled-in file into the PROD_ENV_FILE secret of the GitHub "production" environment
# (.github/workflows/deploy.yml writes it to the server on every deploy). Never commit the real file.
# Generate secrets with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"

ENV=production
LOG_JSON=true
APP_VERSION=0.1.0

# The public address (Caddy gets a Let's Encrypt certificate for DOMAIN)
DOMAIN=kainem.example.ru
PUBLIC_APP_URL=https://kainem.example.ru

# Postgres: the password must be the same in both lines
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://kainem:change-me@postgres:5432/kainem
REDIS_URL=redis://redis:6379/0

# Telegram: a separate production bot (BotFather), see docs/deployment.md §2
BOT_TOKEN=
BOT_USERNAME=kainem_bot
BOT_WEBHOOK_SECRET=change-me
# The bot long-polls through the xray container (Telegram is blocked from Russian servers, ADR 0004)
TELEGRAM_PROXY=socks5://xray:1080

# Auth: required, the API refuses to start in production with the dev default
JWT_SECRET=

# LLM: the Sber500 accelerator proxy (OpenAI-compatible)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://shared1.multitool.works:4000/v1
LLM_API_KEY=
# Capture model: must accept images (VLM, ADR 0005); check-models lists the names the proxy knows
LLM_MODEL_EXTRACTION=qwen3-vl-30b-a3b-instruct
LLM_MODEL_CHAT=gigachat-3-pro
LLM_PROGRAM_BUDGET_RUB=75000
LLM_FAMILY_DAILY_QUOTA_RUB=50

# Grafana: https://<DOMAIN>/grafana/, sign in as admin with this password (docs/deployment.md §5.6)
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PG_USER=grafana_reader
GRAFANA_PG_PASSWORD=change-me

# Optional
SENTRY_DSN=
