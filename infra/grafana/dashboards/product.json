{
  "uid": "kainem-product",
  "title": "kainem — product",
  "tags": [
    "kainem"
  ],
  "timezone": "Europe/Moscow",
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "DAU / WAU / MAU",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, dau, wau, mau FROM metrics_active_users WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "description": "Active = user-initiated action (ADR 0003). Test and load-test accounts excluded."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DAU by platform",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, platform AS metric, dau FROM metrics_dau_by_platform WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Stickiness (DAU / MAU)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, round(dau::numeric / nullif(mau, 0), 3) AS stickiness FROM metrics_active_users WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active families",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, active_families FROM metrics_active_users WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "New users by source",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, acquisition_source AS metric, sum(new_users) AS new_users FROM metrics_new_users WHERE $__timeFilter(day::timestamp) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "New families",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, new_families FROM metrics_new_families WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Registration funnel (period)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(welcome_viewed) AS \"1 welcome\", sum(register_clicked) AS \"2 register clicked\", sum(logged_in) AS \"3 logged in\", sum(onboarding_completed) AS \"4 onboarding done\", sum(first_item_created) AS \"5 first item\" FROM metrics_registration_funnel WHERE $__timeFilter(day::timestamp)"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Invite funnel and k-factor (period)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(invites_created) AS created, sum(invites_shared) AS \"shared (button)\", sum(invites_opened) AS opened, sum(invites_accepted) AS accepted, round(sum(signups_via_invite)::numeric / nullif(sum(signups_other), 0), 2) AS k_factor FROM metrics_invites WHERE $__timeFilter(day::timestamp)"
        }
      ],
      "description": "k-factor = signups via invite / other signups. Shares via plain forward are invisible: a lower bound."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "AI drafts: confirmed / revised / cancelled / expired",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, confirmed, revised, cancelled, expired FROM metrics_ai_quality WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "AI confirm rate and failures",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, confirm_rate, round(failed_llm::numeric / nullif(captures, 0), 3) AS llm_failure_rate, round(failed_no_items::numeric / nullif(captures, 0), 3) AS no_items_rate FROM metrics_ai_quality WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "LLM cost per day by feature, ₽",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyRUB",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, feature || ' / ' || model AS metric, cost_rub FROM metrics_llm_cost WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "₽ per DAU and per active family",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyRUB"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, rub_per_dau, rub_per_active_family FROM metrics_cost_per_dau WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "description": "Acceptance: LLM cost per DAU. Unpriced calls (no proxy cost, no price row) count as 0; see metrics_llm_cost.unpriced_calls."
    },
    {
      "id": 13,
      "type": "table",
      "title": "Retention by cohort (D1 / D7 / D30)",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT day AS cohort, users, round(d1::numeric / users, 3) AS d1, round(d7::numeric / users, 3) AS d7, round(d30::numeric / users, 3) AS d30 FROM metrics_retention WHERE $__timeFilter(day::timestamp) ORDER BY 1 DESC"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Family activation (≥2 members and ≥3 items in 7 days)",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, round(activated::numeric / nullif(families, 0), 3) AS activation_rate FROM metrics_activation WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ]
    }
  ],
  "editable": true
}