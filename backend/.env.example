# Copy to .env for local development. Never commit real secrets.
ENV=local
LOG_JSON=false
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://kainem:kainem@localhost:5432/kainem
REDIS_URL=redis://localhost:6379/0

# Telegram (use a separate test bot per environment)
BOT_TOKEN=
BOT_USERNAME=kainem_dev_bot
BOT_WEBHOOK_SECRET=change-me
# Optional proxy for Bot API calls, e.g. socks5://127.0.0.1:1080 (production: socks5://xray:1080, ADR 0004)
TELEGRAM_PROXY=

# Auth (ADR 0002). JWT_SECRET is required outside local/test: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
# Test-only endpoint that simulates the bot for e2e tests (local/test env only)
ENABLE_TEST_ENDPOINTS=false

# LLM: "fake" spends nothing; "openai_compatible" uses the Sber500 accelerator proxy
LLM_PROVIDER=fake
LLM_BASE_URL=https://shared1.multitool.works:4000/v1
LLM_API_KEY=
LLM_MODEL_EXTRACTION=deepseek-v4.1-flash
LLM_MODEL_CHAT=gigachat-3-pro
LLM_PROGRAM_BUDGET_RUB=50000
LLM_FAMILY_DAILY_QUOTA_RUB=50

SENTRY_DSN=
